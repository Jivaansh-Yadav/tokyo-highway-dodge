# Environment variables
#
# Copy this file to `.env.local` and adjust as needed.

# Product title/description used for the app's <title> and meta description.
NEXT_PUBLIC_APP_TITLE=Tokyo Highway Dodge
NEXT_PUBLIC_APP_DESCRIPTION=A webcam-controlled car dodging game using fist gestures.

# No other environment variables are required. Scores are stored in the browser's
# localStorage; nothing is uploaded to a server.
